# Copy to .env and fill in as needed.
# All values can stay empty during the prototype stage.
# Keep this file ASCII-only: on Chinese Windows .env is read with GBK,
# and non-ASCII content can raise UnicodeDecodeError.

# Used when classify_node is switched to an LLM
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
